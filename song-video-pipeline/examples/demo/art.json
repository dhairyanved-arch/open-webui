{
	"look": { "desk": "walnut", "tones": ["night", "ember", "dusk"], "accent": "#ffb24a", "masthead": "The Late Edition" },
	"rules": [
		{ "match": "\\bmap\\b", "prop": "map", "opts": { "to": "Out of town", "from": "Home", "places": ["Old Quarter", "Riverside", "Night Market", "The Overlook", "Station Rd"] } },
