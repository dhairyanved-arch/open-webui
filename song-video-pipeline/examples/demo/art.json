		{ "match": "\\briver\\b", "prop": "ticket", "opts": { "from": "HERE", "to": "GONE", "label": "DESTINATION" } },
		{ "match": "\\bsearch\\b", "prop": "search" },
		{ "match": "\\bfront page\\b", "prop": "newspaper" },
		{ "match": "\\bpicture\\b", "prop": "polaroid", "opts": { "photos": ["road", "figures", "city"] } },
		{ "match": "\\bpin\\b", "prop": "sticky" },
		{ "match": "\\bstars\\b", "prop": "stars" }
	]
